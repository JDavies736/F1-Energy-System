%% Speed profile
clear;
clc;

vehicle_parameters;
% Define parameters
t = 10;
v_max = 105;
a_max = 30;
t_accel = v_max / a_max;

% Time Velocity vectors
time = linspace(0, t, 100); 
velocity = zeros(size(time)); 

% Calculate velocity during acceleration phase
for i = 1:length(time)
    if time(i) <= t_accel
        velocity(i) = a_max * time(i); % accelerate
    elseif time(i) > (t - t_accel)
        velocity(i) = v_max - a_max * (time(i) - (t - t_accel)); % decelerate
    else
        velocity(i) = v_max; % constant speed
    end
end

% Vehicle Acceleration
accel = gradient(velocity, time);

% Incorporate accel limitations
max_accel_power = zeros(size(velocity))

for i = 1:length(velocity)
    if velocity(i) > 0
        F_motor_max = max_motor_power_W / velocity(i);
        F_resistance = 0.5 .* rho .* Cd .* Fr_A .* velocity(i).^2 * Crr .* mass .* g;
        max_accel_power(i) = (F_motor_max - F_resistance) / mass;
    else
        max_accel_power(i) = a_max;
    end
end

accel_limit = min(max_accel_power, a_max);

% Forces
F_accel = mass .* accel;
F_drag = 0.5 .* rho .* Cd .* Fr_A .* velocity.^2;
F_rolling = Crr .* mass .* g;
F_total = F_accel + F_drag + F_rolling;
P_required = F_total .* velocity;

% Battery
P_battery = zeros(size(P_required));
% Whilst accelerating/cruising
driving = P_required >= 0;
P_battery(driving) = P_required(driving) ./ motor_efficiency;
% Regenerative braking
braking = P_required < 0;
P_battery(braking) = P_required(braking) ./ regen_efficiency;
% Incorporate max parameter
max_regen = max_regen_power * 1000;
regen_power = P_battery(braking);
regen_power = max(regen_power, -max_regen);
P_battery(braking) = regen_power;

regen_energy = trapz(time, max(-P_battery, 0));
regen_energy_kWh = regen_energy / (3600 * 1000);
fprintf('Energy recovered by regenerative braking: %.2f kWh\n', regen_energy_kWh);

battery_energy = trapz(time, max(P_battery, 0));
battery_energy_kWh = battery_energy / (3600 * 1000);
fprintf('Energy consumed by the battery: %.2f kWh\n', battery_energy_kWh);

total_energy = battery_energy_kWh - regen_energy_kWh;
fprintf('Total energy consumed: %.2f kWh\n', total_energy)

% Plot
% Speed profile
figure;
plot(time, velocity, 'r-');
xlabel('Time (s)')
ylabel('Velocity (m/s)')
title('Speed Profile of Accelerating and Decelerating')
grid on;

% Battery power usage
figure;
plot(time, P_battery / 1000, 'g-');
xlabel('Time (s)')
ylabel('Battery Power (kW)')
title('Demand of Battery Power')
yline(0, 'k--')
grid on;

% Acceleration incorporating limitations
figure;
plot(time, accel_limit, 'r--');
xlabel('Time (s)');
ylabel('')

